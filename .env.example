# Заготовка окружения. Секретов тут нет и быть не должно.
# Рабочий .env создаёт scripts/iso-setup.sh в своей копии проекта и в git не попадает.

# Ядро: наша база. Поднимается docker-compose.yml (Postgres 17 + pgvector).
DATABASE_URL=postgres://ss:ss@localhost:5433/ss_core

# Вход. Секрет генерирует iso-setup.sh; в этой заготовке он пустой.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGINS=http://localhost:5173

# API
PORT=8787

# Журнал
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_DIR=./.data/logs

# Очередь: брокер отдельным процессом (bunqueue start)
BUNQUEUE_HOST=127.0.0.1
BUNQUEUE_PORT=6789

# Модель
LLM_BASE_URL=https://api.commandcode.ai/provider/v1/
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Apple (включается, когда заданы оба ключа)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=

# Разработка: куда воркер стучится с рассказами о работе и куда web шлёт запросы.
# API_URL — для воркера; API_ORIGIN — для прокси vite, когда web идёт на своём порту.
API_URL=http://127.0.0.1:8787
API_ORIGIN=http://localhost:8787

# Пароль между API и воркером: воркер рассказывает о работе через вход /v1/events/jobs
WORKER_TOKEN=

# Агент: отдельный сервис, с которым API говорит по вебсокету.
# AGENT_URL — адрес этого сервиса, AGENT_SECRET — его пароль.
AGENT_URL=
AGENT_SECRET=

# Cloudflare: доступ кланкера к платформе идёт через наш прокси /v1/cloudflare.
# Ключ аккаунта наружу не отдаётся: его подставляет прокси. Пусто — прокси отвечает 503.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
