# Заготовка окружения. Секретов тут нет и быть не должно.
# Рабочий .env создаёт scripts/iso-setup.sh в своей копии проекта и в git не попадает.

# Ядро: наша база. Поднимается docker-compose.yml (Postgres 17 + pgvector).
DATABASE_URL=postgres://ss:ss@localhost:5433/ss_core

# Вход. Секрет генерирует iso-setup.sh; в этой заготовке он пустой.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGINS=http://localhost:5173

# API
PORT=8787

# Очередь: брокер отдельным процессом (bunqueue start)
BUNQUEUE_HOST=127.0.0.1
BUNQUEUE_PORT=6789
BUNQUEUE_HTTP_PORT=6790

# Модель
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Телеграм
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Apple (включается, когда заданы оба ключа)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Миниаппы
APPS_ROOT=./.data/apps
APPS_BASE_DOMAIN=apps.localtest.me
