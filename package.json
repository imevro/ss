{
  "name": "react-router-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "iso": "scripts/iso-setup.sh",
    "db:generate": "cd packages/db && bun x drizzle-kit generate",
    "db:migrate": "cd packages/db && bun x drizzle-kit migrate",
    "db": "docker compose exec -T db psql -U ss -d ss_core",
    "broker": "bun run --cwd apps/worker broker",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "turbo": "^2.11.5",
    "typescript": "^6.0.2",
    "@biomejs/biome": "2.4.4"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "motion": "^13.5.0"
  }
}
