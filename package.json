{
  "name": "react-router-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "iso": "scripts/iso-setup.sh",
    "db:generate": "bun --env-file=.env x drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "bun --env-file=.env x drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db": "docker compose exec -T db psql -U ss -d ss_core",
    "broker": "bun run --cwd apps/worker broker"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
