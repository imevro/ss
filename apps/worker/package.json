{
  "name": "@workspace/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "broker": "bunqueue start --tcp-port 6789 --http-port 6790 --data-path .data/queue.db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/companies": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/log": "workspace:*",
    "@workspace/types": "workspace:*",
    "bunqueue": "^2.9.6",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "postgres": "^3.4.9"
  }
}
